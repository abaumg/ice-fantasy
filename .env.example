# Vorlage: nach .env kopieren und ausfüllen. Die .env steht in .gitignore.
# Werte ohne Anführungszeichen oder in "..." / '...'. Keine Kommentare hinter dem Wert.

# Login eines Fantasy-Accounts (am besten ein eigener Account für das Skript)
ICEHL_EMAIL=
ICEHL_PASSWORD=

# Statischer App-Schlüssel für den Login-Request
ICEHL_API_KEY=

# Optional
# ICEHL_SEASON=2026
# ICEHL_LEAGUE=1
